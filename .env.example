# CRM Copilot MVP — environment variable convention.
# This file lists variable NAMES only. No real values/secrets belong here or in git.
# Copy to `.env` locally (ignored by git) and fill in real values when the
# checkpoint that introduces them is reached.

# --- P0-02: Mock CRM API ---
# Base URL the MCP Server uses to call CrmCopilot.MockCrmApi.
MOCKCRM_API_BASE_URL=

# --- P0-03: Gemini + Chroma RAG ---
# Gemini API key. Not required/requested until P0-03.
GEMINI_API_KEY=
# Chroma server base URL (client/server HTTP mode).
CHROMA_BASE_URL=

# --- P0-05: AI Host + MCP Client ---
# Base URL the Web/AI Host uses to reach CrmCopilot.McpServer.
MCPSERVER_BASE_URL=
