# CRM Copilot MVP — environment variable convention.
# This file lists variable NAMES only. No real values/secrets belong here or in git.
# Copy to `.env` locally (ignored by git) and fill in real values when the
# checkpoint that introduces them is reached.

# --- P0-02: Mock CRM API ---
# Base URL the MCP Server uses to call CrmCopilot.MockCrmApi.
MOCKCRM_API_BASE_URL=

# --- P0-03: Gemini + Chroma RAG ---
# Gemini API key. Not required/requested until P0-03.
# As of P0-05, CrmCopilot.Web also reads this same variable name (for Gemini chat/tool-calling,
# gemini-3.5-flash-lite) — independently, in its own process; set it in both terminals.
GEMINI_API_KEY=
# Chroma server base URL (client/server HTTP mode).
CHROMA_BASE_URL=

# --- P0-05: AI Host + MCP Client ---
# Base URL the Web/AI Host uses to reach CrmCopilot.McpServer.
MCPSERVER_BASE_URL=

# --- P0-09 Pha B: Docker Compose ---
# Which of the variables above matter depends on how you run the stack.
#
# `dotnet run` workflow (README §9A):
#   The application has NO dotenv loader — copying this file to `.env` does
#   nothing for `dotnet run`. Use .NET User Secrets for GEMINI_API_KEY and
#   appsettings.Development.json / $env: for the three URLs.
#
# `docker compose` workflow (README §9B):
#   Compose DOES read `.env` at the repo root, but only for `${...}`
#   interpolation inside compose.yaml — and compose.yaml interpolates exactly
#   two names:
#     GEMINI_API_KEY          (required; compose fails fast if unset or blank)
#     CHROMA_COLLECTION_NAME  (optional; defaults to crm-copilot-knowledge)
#   MOCKCRM_API_BASE_URL, CHROMA_BASE_URL and MCPSERVER_BASE_URL are IGNORED by
#   compose — it hard-codes them to compose service names
#   (http://mockcrmapi:8080, http://chroma:8000, http://mcpserver:8080). Leaving
#   a localhost value in `.env` is harmless; it never reaches a container.

# Optional in both workflows. Default: crm-copilot-knowledge.
# The opt-in live tests use crm-copilot-knowledge-livetest instead.
CHROMA_COLLECTION_NAME=
